{
  "name": "emotion-diary",
  "version": "3.7.0",
  "description": "Windows 情绪记录 · 本地离线 · 强提醒",
  "main": "./out/main/index.js",
  "author": "123yangyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/123yangyan/emotion.git"
  },
  "homepage": "https://github.com/123yangyan/emotion#readme",
  "bugs": {
    "url": "https://github.com/123yangyan/emotion/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "seed:ai-insight": "node scripts/seed-ai-insight-test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  },
  "build": {
    "appId": "com.emotion.diary",
    "productName": "情绪记录",
    "directories": {
      "output": "release"
    },
    "artifactName": "emotion-diary-setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "123yangyan",
        "repo": "emotion"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/tray-icon@2x.png",
        "to": "tray-icon@2x.png"
      },
      {
        "from": ".claude",
        "to": "ai-kit/.claude"
      },
      {
        "from": ".cursor/skills/emotion-diary-ai",
        "to": "ai-kit/.cursor/skills/emotion-diary-ai"
      },
      {
        "from": "docs/AI使用与修改说明.md",
        "to": "ai-kit/docs/AI使用与修改说明.md"
      },
      {
        "from": "resources/ai-kit-README.md",
        "to": "ai-kit/README.md"
      }
    ]
  }
}
